# Production Environment Configuration for Roshd Platform
# Generate JWT_SECRET using: openssl rand -hex 48
NODE_ENV=production
PORT=5000
HOST=127.0.0.1

# Mandatory: Minimum 32 characters
JWT_SECRET=replace_with_openssl_rand_hex_48_generated_secret_at_least_32_chars

# Database & Storage
DB_PATH=./backend/rosh.db
UPLOADS_PATH=./backend/uploads
BACKUPS_PATH=./backend/backups

# Security & CORS
CORS_ORIGIN=https://roshd.digiral.ir
RATE_LIMIT_MAX=10000

# Required only for a new database without an admin (at least 12 characters).
# Existing administrator credentials and sessions are left unchanged.
ADMIN_NATIONAL_ID=0011223344
ADMIN_INITIAL_PASSWORD=

